// Winz data model — multi-tenant from day one.
// Postgres in production (Neon/Supabase). Runtime falls back to seed data when
// DATABASE_URL is unset (see src/server/db.ts), so the app runs with zero config.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Platform {
  TIKTOK
  YOUTUBE
  INSTAGRAM
  KICK
}

enum AccountRole {
  MAIN
  CLIPS
}

enum WarmupState {
  NEW // created, not yet connected/warming
  WARMING // connected, ramping posting cadence up
  READY // fully warmed, full cadence
}

enum StreamStatus {
  LIVE
  UPLOADING // source upload in progress
  QUEUED // ready for the worker to pick up
  PROCESSING
  DONE
  FAILED
}

enum ClipStatus {
  PENDING // awaiting review
  APPROVED
  SCHEDULED
  POSTED
  SKIPPED
}

enum PostStatus {
  SCHEDULED
  POSTING // worker is uploading right now
  PROCESSING // bytes delivered, platform hasn't committed yet
  POSTED
  FAILED
}

model Tenant {
  id        String          @id @default(cuid())
  name      String
  kickSlug  String?         @unique
  // Plan tier: ADMIN (founder — unlimited), FREE, PRO. String (not enum) so
  // adding tiers later is data, not a migration.
  plan      String          @default("FREE")
  // Comma-separated ISO language codes to auto-dub approved clips into
  // (e.g. "es,pt"). Empty/null = dubbing off.
  dubLanguages String?
  // Clip framing: "crop" (centre-cut), "blurpad" (letterbox), or "split"
  // (facecam over gameplay). facecam is "x,y,w,h" as 0-1 fractions of the
  // source frame — required for split, which falls back to crop without it.
  clipLayout   String  @default("crop")
  facecam      String?
  createdAt DateTime        @default(now())
  users     User[]
  accounts  SocialAccount[]
  streams   Stream[]
  clips     Clip[]
  posts     Post[]
  apiKeys   ApiKey[]
  dubs      Dub[]
  captures  ChatCapture[]
}

model User {
  id           String    @id @default(cuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  email        String    @unique
  name         String?
  passwordHash String?
  createdAt    DateTime  @default(now())
  sessions     Session[]

  @@index([tenantId])
}

model Session {
  id        String   @id @default(cuid())
  // sha256 of the cookie token — a DB leak alone can't hijack sessions.
  tokenHash String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

// Fixed-window rate-limit counters (login/signup brute-force protection).
model RateLimit {
  bucket  String   @id // e.g. "login:ip:1.2.3.4" or "login:email:x@y.z"
  count   Int      @default(0)
  resetAt DateTime
}

model ApiKey {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name       String
  // sha256 of the key (shown to the user once at creation).
  keyHash    String    @unique
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([tenantId])
}

model SocialAccount {
  id             String      @id @default(cuid())
  tenantId       String
  tenant         Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  platform       Platform
  role           AccountRole @default(MAIN)
  handle         String
  externalId     String?
  connected      Boolean     @default(false)
  warmupState    WarmupState @default(NEW)
  connectedAt    DateTime?
  followers      Int?
  // Tokens are encrypted at rest in production (app-layer). Never logged.
  accessToken    String?
  refreshToken   String?
  tokenExpiresAt DateTime?
  createdAt      DateTime    @default(now())
  posts          Post[]

  @@unique([tenantId, platform, handle])
  @@index([tenantId])
}

model Stream {
  id              String       @id @default(cuid())
  tenantId        String
  tenant          Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  kickVideoId     String?
  title           String
  status          StreamStatus @default(LIVE)
  sourceKey       String? // object key in R2
  sourceUrl       String? // public URL the worker fetches
  claimedAt       DateTime? // when a worker claimed it; stale claims get requeued
  // Earliest the worker may claim this. Set when a Kick VOD isn't published
  // yet, so the retry waits minutes instead of hammering the queue.
  notBefore       DateTime?
  // Live chat recorded while this stream was on air, if any.
  chatCaptureId   String?
  chatCapture     ChatCapture? @relation(fields: [chatCaptureId], references: [id], onDelete: SetNull)
  startedAt       DateTime     @default(now())
  endedAt         DateTime?
  durationSec     Int?
  momentsDetected Int          @default(0)
  clips           Clip[]

  @@index([tenantId])
}

model Clip {
  id                String     @id @default(cuid())
  tenantId          String
  tenant            Tenant     @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  streamId          String
  stream            Stream     @relation(fields: [streamId], references: [id], onDelete: Cascade)
  title             String
  hook              String?
  durationSec       Int
  score             Int        @default(0)
  signal            String?
  status            ClipStatus @default(PENDING)
  assignedPlatform  Platform?
  flaggedMusic      Boolean    @default(false)
  storageKey        String?
  startMs           Int?
  endMs             Int?
  // Dubbed variants: lang is the spoken language, sourceClipId points at the
  // original clip this was dubbed from (null for originals).
  lang              String?
  sourceClipId      String?
  createdAt         DateTime   @default(now())
  posts             Post[]
  dubs              Dub[]

  @@index([tenantId, status])
  @@index([streamId])
}

model Post {
  id           String        @id @default(cuid())
  tenantId     String
  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clipId       String
  clip         Clip          @relation(fields: [clipId], references: [id], onDelete: Cascade)
  accountId    String
  account      SocialAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)
  platform     Platform
  status       PostStatus    @default(SCHEDULED)
  scheduledFor DateTime?
  postedAt     DateTime?
  externalId   String?
  externalUrl  String?
  /// Why this post failed, in the platform's own words. Shown to the creator —
  /// "failed" with no reason is the complaint every competitor gets.
  error        String?
  views        Int?
  likes        Int?
  // Per-post publish options chosen by the user at approval time (e.g. TikTok
  // privacy_level + interaction toggles — required by TikTok's UX guidelines).
  meta         Json?
  createdAt    DateTime      @default(now())

  @@index([tenantId])
  @@index([clipId])
}

// Idempotency + audit for inbound platform webhooks (Kick stream events, etc.)
model WebhookEvent {
  id         String   @id @default(cuid())
  source     String // "kick"
  kind       String // "livestream.status.updated"
  messageId  String   @unique
  payload    Json
  receivedAt DateTime @default(now())
}

/// A requested dub of one clip into one language. The worker claims QUEUED rows,
/// sends the clip to ElevenLabs, waits for the dub, stores the result in R2, and
/// creates a new Clip row for it so it flows through review + posting normally.
model Dub {
  id         String    @id @default(cuid())
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  clipId     String
  clip       Clip      @relation(fields: [clipId], references: [id], onDelete: Cascade)
  lang       String
  status     String    @default("QUEUED") // QUEUED | PROCESSING | DONE | FAILED
  externalId String? // ElevenLabs dubbing_id
  dubClipId  String? // the Clip row created for the finished dub
  error      String?
  claimedAt  DateTime?
  attempts   Int       @default(0)
  createdAt  DateTime  @default(now())

  @@unique([clipId, lang])
  @@index([tenantId])
}

/// One live stream's chat, recorded off Kick's public Pusher socket while the
/// broadcast is on air. Chat velocity is the hype signal the podcast-shaped
/// clippers don't have — when chat erupts, that's the clip.
///
/// Only counts are kept, never message text or authors.
model ChatCapture {
  id            String    @id @default(cuid())
  tenantId      String
  tenant        Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  broadcasterId String // Kick broadcaster user_id
  slug          String // Kick channel slug
  chatroomId    String? // Pusher chatroom id, resolved by the worker
  status        String    @default("QUEUED") // QUEUED | RECORDING | DONE
  /// Kick's own stream start. Every offset is measured from this, and the VOD
  /// is assumed to start at the same instant — get this wrong and the signal
  /// points at the wrong moments, so it comes from Kick, never from our clock.
  streamStartedAt DateTime
  endedAt       DateTime?
  messages      Int       @default(0)
  error         String?
  claimedAt     DateTime?
  attempts      Int       @default(0)
  createdAt     DateTime  @default(now())
  buckets       ChatBucket[]
  streams       Stream[]

  @@index([tenantId])
  @@index([status])
}

/// One minute of chat velocity: 60 per-second message counts. Rewritten in
/// place on each flush, so a crashed recorder loses at most one interval.
model ChatBucket {
  id        String      @id @default(cuid())
  captureId String
  capture   ChatCapture @relation(fields: [captureId], references: [id], onDelete: Cascade)
  minute    Int // minutes since streamStartedAt
  counts    Int[] // length 60, one per second

  @@unique([captureId, minute])
}
