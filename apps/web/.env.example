# Copy to .env.local (dev) or set in Vercel project settings (prod).
# The app runs WITHOUT any of these — it falls back to seed data — but set them
# to enable the real database and Kick integration.

# Postgres (Neon / Supabase / your own). When unset, the app serves seed data.
DATABASE_URL=

# Public URL of this app (used to build OAuth redirect URIs, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Kick OAuth app (create at kick.com/settings/developer)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3000/api/auth/kick/callback
