# Copy to .env and fill in real values — never commit .env
# These are the WEB APP's variables (Vercel). The worker has its own set in
# worker/.env.example.

# --- Database (Neon) ---
# Vercel's Neon integration sets both of these for you.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Comma-separated. These emails claim the founding (unlimited) workspace on signup.
ADMIN_EMAILS=

# --- Kick (kick.com/settings/developer) — OAuth + stream webhooks ---
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3000/api/auth/kick/callback

# --- TikTok app (developers.tiktok.com) — Content Posting API ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok/callback
# Must match EXACTLY what your app has enabled, or TikTok rejects the login.
# Add video.list once the app is audited — that's what view counts need.
# TIKTOK_SCOPES=user.info.basic,video.upload,video.publish

# --- Instagram app (developers.facebook.com) — Instagram Login ---
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# --- Cloudflare R2 — clip storage (presigned PUT + public URL) ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
