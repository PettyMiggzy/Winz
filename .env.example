# Copy to .env and fill in real values — never commit .env
VENICE_API_KEY=

# --- Web app (Next.js) ---
DATABASE_URL=
NEXT_PUBLIC_APP_URL=http://localhost:3000
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=
KICK_REDIRECT_URI=http://localhost:3000/api/auth/kick/callback

# TikTok app (developers.tiktok.com) — Content Posting API
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:3000/api/auth/tiktok/callback

# Instagram app (developers.facebook.com) — Instagram Login + content publishing
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
INSTAGRAM_REDIRECT_URI=http://localhost:3000/api/auth/instagram/callback

# Cloudflare R2 for upload storage (presigned PUT + public URL for IG fetch)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=
