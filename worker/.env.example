# Copy to .env. The worker runs on your own server (needs FFmpeg + Redis).
REDIS_URL=redis://localhost:6379
FFMPEG_PATH=ffmpeg
WORK_DIR=/tmp/winz

# Transcription (Whisper via Groq) + LLM scoring.
# The engine uses one OpenAI-compatible key for both by default.
GROQ_API_KEY=

# Optional: point the LLM scorer at any OpenAI-compatible endpoint/model.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Music fingerprinting (safety gate before publish)
AUDD_API_KEY=

WORKER_CONCURRENCY=2
