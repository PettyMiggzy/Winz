# Copy to .env. The worker runs on your own server (needs FFmpeg + yt-dlp).
# It polls Postgres for work — no Redis needed — and creates its own tables at
# boot, so point it at the SAME database as the web app.
DATABASE_URL=
FFMPEG_PATH=ffmpeg
WORK_DIR=/tmp/winclipz

# --- Transcription (Whisper via Groq) + LLM scoring ---
GROQ_API_KEY=
# MAX_CLIPS_PER_STREAM=12

# --- R2 (same bucket as the web app) — the worker uploads finished clips here ---
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# --- Link ingestion ---
# Residential proxy (http://user:pass@host:port). REQUIRED for YouTube links
# (datacenter IPs hit bot checks) and for resolving Kick VODs and chatrooms,
# which 403 datacenter IPs.
YTDLP_PROXY=
# Optional: base64 of a cookies.txt for extra YouTube reliability.
# YTDLP_COOKIES_B64=

# --- Posting: our own TikTok app (no vendor) ---
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# direct = posts to the profile (needs an audited app, or sandbox).
# draft  = sends to the creator's TikTok inbox; works without the audit.
TIKTOK_POST_MODE=direct

# --- Posting: vendor bridge (holds the approvals so posts can be public) ---
# upload-post.com is the default pick ($16/mo) and the only route to YouTube
# Shorts today; Blotato is the fallback. Set ONE. Without either, clips are
# still cut — they just aren't auto-posted anywhere we lack our own app for.
UPLOADPOST_API_KEY=
# BLOTATO_API_KEY=

# --- Clip translation (ElevenLabs dubbing, creator's own voice) ---
# Roughly $0.30-0.50 per source minute, so it's plan-gated in the app.
ELEVENLABS_API_KEY=

# --- Kick chat capture ---
# Kick's public chat socket. Only set these if Kick rotates them; the defaults
# are what kick.com's own web client uses.
# KICK_PUSHER_KEY=
# KICK_PUSHER_CLUSTER=us2

# --- NOT WIRED YET ---
# The music safety gate is a stub: worker/src/music.ts always returns "clean",
# so setting this key does nothing today. Clips are NOT screened for claimed
# music before posting.
# AUDD_API_KEY=
