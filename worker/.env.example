# Copy to .env. The worker runs on your own server (needs FFmpeg).
# It polls Postgres for QUEUED streams — no Redis needed.
DATABASE_URL=
FFMPEG_PATH=ffmpeg
WORK_DIR=/tmp/winclipz

# Transcription (Whisper via Groq) + LLM scoring — one OpenAI-compatible key.
GROQ_API_KEY=

# R2 (same bucket as the web app) — the worker uploads finished clips here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional: point the LLM scorer at any OpenAI-compatible endpoint/model.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Music fingerprinting (safety gate before publish)
AUDD_API_KEY=

# Auto-posting provider (holds the TikTok/IG/YouTube approvals so posts can be
# public). upload-post.com is the default pick ($16/mo, 5 accts/platform);
# Blotato is the fallback. Set ONE key. Without either, clips are still cut —
# they just aren't auto-posted.
UPLOADPOST_API_KEY=
# BLOTATO_API_KEY=
# BLOTATO_BASE_URL=https://backend.blotato.com

# YouTube bot-check workaround for link ingestion: base64 of a Netscape
# cookies.txt exported from your browser ("Get cookies.txt LOCALLY" extension):
#   base64 -w0 cookies.txt   → paste the output here
YTDLP_COOKIES_B64=

WORKER_CONCURRENCY=2
