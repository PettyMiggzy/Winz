# Copy to .env. The worker runs on your own server (needs FFmpeg).
# It polls Postgres for QUEUED streams — no Redis needed.
DATABASE_URL=
FFMPEG_PATH=ffmpeg
WORK_DIR=/tmp/winclipz

# Transcription (Whisper via Groq) + LLM scoring — one OpenAI-compatible key.
GROQ_API_KEY=

# R2 (same bucket as the web app) — the worker uploads finished clips here.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# Optional: point the LLM scorer at any OpenAI-compatible endpoint/model.
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.3-70b-versatile

# Music fingerprinting (safety gate before publish)
AUDD_API_KEY=

# Auto-posting provider (holds the TikTok/IG/YouTube approvals so posts can be
# public). upload-post.com is the default pick ($16/mo, 5 accts/platform);
# Blotato is the fallback. Set ONE key. Without either, clips are still cut —
# they just aren't auto-posted.
UPLOADPOST_API_KEY=
# BLOTATO_API_KEY=
# BLOTATO_BASE_URL=https://backend.blotato.com

# In-house TikTok (our own developer app) — used for accounts connected via
# "Connect TikTok" on the site. direct = post to profile (sandbox/audited);
# draft = send to the creator's TikTok drafts (works unaudited).
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# TIKTOK_POST_MODE=direct

# YouTube link ingestion — YouTube bot-blocks datacenter IPs, so downloads
# route through a RESIDENTIAL proxy (pay-per-GB, e.g. DataImpulse/IPRoyal/
# Decodo). Format: http://user:pass@host:port
YTDLP_PROXY=

# Optional extra: base64 of a Netscape cookies.txt from a logged-in browser
# ("Get cookies.txt LOCALLY" extension → base64 -w0 cookies.txt). Combine with
# the proxy for the most reliable YouTube access.
YTDLP_COOKIES_B64=

WORKER_CONCURRENCY=2

# Clip translation (ElevenLabs dubbing — keeps the creator's own voice).
# Without this, clips are still cut and posted; they just aren't translated.
# Cost is ~$0.30-0.50 per source minute, so dubs only run on APPROVED clips.
ELEVENLABS_API_KEY=
# ELEVENLABS_BASE_URL=https://api.elevenlabs.io
