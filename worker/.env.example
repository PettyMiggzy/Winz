# Copy to .env. The worker runs on your own server (needs FFmpeg + Redis).
REDIS_URL=redis://localhost:6379
FFMPEG_PATH=ffmpeg
WORK_DIR=/tmp/winz
CAPTION_FONT=

# Transcription: "local" (faster-whisper sidecar) or "groq"
WHISPER_MODE=local
WHISPER_MODEL=large-v3-turbo
GROQ_API_KEY=

# LLM scoring + titles
ANTHROPIC_API_KEY=
SCORING_MODEL=claude-haiku-4-5-20251001

# Music fingerprinting
AUDD_API_KEY=

MAX_CLIPS_PER_STREAM=12
WORKER_CONCURRENCY=2
